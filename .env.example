# StockSense Environment Configuration
# Mandatory Database Configuration - Neon Serverless PostgreSQL
# Replace USER, PASSWORD, HOST, and DATABASE with your Neon credentials
# Example host: ep-cold-pond-a5xyz.us-east-2.aws.neon.tech
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: Dedicated Test Database for destructive integration tests
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/stocksense_test?sslmode=require

# Security Secrets (Must change in production)
SECRET_KEY=stocksense-production-secret-key-replace-with-random-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Configuration
DEFAULT_NEAR_EXPIRY_DAYS=30
DEFAULT_LEAD_TIME_DAYS=7
DEFAULT_SAFETY_STOCK_FACTOR=1.5
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
